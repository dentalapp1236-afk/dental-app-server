PORT=5000
# Single database for ALL environments (local + production use the same one).
# Use your Atlas production connection string here, locally and on Render.
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<dbname>
# Optional: explicit database name (overrides the one embedded in MONGO_URI).
# Leave blank to use the db named in MONGO_URI.
MONGO_DB=
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=15d
# Comma-separated allowed front-end origins (patient app AND admin panel).
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Platform admin (run `npm run seed:admin` once to create/update it).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Email (password reset) via Resend — https://resend.com
# Leave RESEND_API_KEY blank to log reset links to the server console instead of sending.
RESEND_API_KEY=
MAIL_FROM=MyDentalBooking <onboarding@resend.dev>

# Web Push (background notifications) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mydentalbooking.app

# Secret for the external cron trigger (/api/cron/run-reminders) — any long random string
CRON_SECRET=

# Cloudinary (profile photo storage) — https://cloudinary.com (free tier is plenty).
# Find these on your Cloudinary dashboard. Either set the three split vars below,
# or set a single CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Daily DB backup (jobs/backup.js) — uploads a gzipped dump to the Cloudinary
# account above as a safety net for the free Atlas tier, which has no backup
# of its own. Optional: how many days of backups to keep (default 14).
BACKUP_RETENTION_DAYS=14

# Bank details shown on the "Payment details" section of the invoice PDF
# (utils/invoicePdf.js) that clinics transfer their subscription fee to.
# Optional — falls back to the values already in use if left blank.
PAYMENT_BANK_NAME=Allied Bank Limited
PAYMENT_ACCOUNT_TITLE=Hamza Mansoor
PAYMENT_ACCOUNT_NUMBER=04810010078559090018
