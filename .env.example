PORT=5000
MONGO_URI=mongodb://localhost:27017/dental-clinic
# Database name. Locally set this to a "*-dev" DB so dev never touches prod data.
# Leave empty/unset in production to use the database named in MONGO_URI.
# (If unset and NODE_ENV is not "production", the server auto-uses "<db>-dev".)
MONGO_DB=dental-clinic-dev
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=24h
CLIENT_ORIGIN=http://localhost:5173

# Email (password reset) via Resend — https://resend.com
# Leave RESEND_API_KEY blank to log reset links to the server console instead of sending.
RESEND_API_KEY=
MAIL_FROM=MyDentalBooking <onboarding@resend.dev>

# Web Push (background notifications) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mydentalbooking.app

# Secret for the external cron trigger (/api/cron/run-reminders) — any long random string
CRON_SECRET=

# Cloudinary (profile photo storage) — https://cloudinary.com (free tier is plenty).
# Find these on your Cloudinary dashboard. Either set the three split vars below,
# or set a single CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp Business Cloud API (Meta) — https://developers.facebook.com/docs/whatsapp/cloud-api
# Leave WHATSAPP_TOKEN/PHONE_NUMBER_ID blank to disable WhatsApp (messages are skipped).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Local-number country code (92 = Pakistan). Used to convert "03001234567" -> "923001234567".
WHATSAPP_COUNTRY_CODE=92
# Template language code, must match how you created the templates in Meta (e.g. en_US).
WHATSAPP_TEMPLATE_LANG=en_US
# Approved template names (create these in Meta Business Manager).
WA_TEMPLATE_WELCOME=patient_welcome
WA_TEMPLATE_NOTIFY=clinic_notification
# Any random string you also paste into Meta when configuring the webhook callback URL.
WHATSAPP_VERIFY_TOKEN=
