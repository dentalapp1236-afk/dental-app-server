PORT=5000
MONGO_URI=mongodb://localhost:27017/dental-clinic
# Database name. Locally set this to a "*-dev" DB so dev never touches prod data.
# Leave empty/unset in production to use the database named in MONGO_URI.
# (If unset and NODE_ENV is not "production", the server auto-uses "<db>-dev".)
MONGO_DB=dental-clinic-dev
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=24h
# Comma-separated allowed front-end origins (patient app AND admin panel).
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Platform admin (run `npm run seed:admin` once to create/update it).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Email (password reset) via Resend — https://resend.com
# Leave RESEND_API_KEY blank to log reset links to the server console instead of sending.
RESEND_API_KEY=
MAIL_FROM=MyDentalBooking <onboarding@resend.dev>

# Web Push (background notifications) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mydentalbooking.app

# Secret for the external cron trigger (/api/cron/run-reminders) — any long random string
CRON_SECRET=

# Cloudinary (profile photo storage) — https://cloudinary.com (free tier is plenty).
# Find these on your Cloudinary dashboard. Either set the three split vars below,
# or set a single CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
